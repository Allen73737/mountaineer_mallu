VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional: error tracking (sentry.io) and cookie-free page analytics (plausible.io or a self-hosted copy).
# Leave empty to keep both off.
VITE_SENTRY_DSN=
VITE_ANALYTICS_DOMAIN=
# VITE_ANALYTICS_SRC=https://analytics.example.com/js/script.js

# Optional: real-user speed monitoring (Core Web Vitals sent to /api/vitals). On in production by default.
# VITE_RUM=false
# VITE_RUM_SAMPLE=0.25
# Optional: CDN for the hashed build assets (JS, CSS, fonts). Also set CDN_URL on the backend.
# VITE_CDN_URL=https://cdn.mountaineermallu.com
