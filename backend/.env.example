# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mountaineer-mallu?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=dmkurjqoa
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP Configuration (for Forgot Password OTP via Resend/SendGrid/etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key

# Resend (Email)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@mountaineermallu.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Super Admin Seed
SEED_ADMIN_EMAIL=superadmin@mountaineermallu.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
