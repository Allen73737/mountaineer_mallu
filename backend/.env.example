# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mountaineer-mallu?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=dmkurjqoa
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP Configuration (for Forgot Password OTP via Resend/SendGrid/etc.)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key

# Resend (Email)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@mountaineermallu.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Super Admin Seed
SEED_ADMIN_EMAIL=superadmin@mountaineermallu.com
SEED_ADMIN_PASSWORD=ChangeThisPassword123!

# Redis (Tiered Caching)
REDIS_URL=redis://default:your_redis_password@your_redis_host:port

# ─── Performance & observability (all optional) ───
# Background job queue concurrency (emails in flight at once)
# JOB_CONCURRENCY=4
# Timeout for calls to third-party APIs, in ms
# EXTERNAL_TIMEOUT_MS=8000
# Requests slower than this are logged as [Slow], in ms
# SLOW_REQUEST_MS=1000
# OpenTelemetry traces (Honeycomb, Grafana Tempo, Jaeger, an OTel Collector...)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=your_key
# OTEL_SERVICE_NAME=mountaineer-mallu-api
# CDN origin serving the frontend build assets (same as the frontend VITE_CDN_URL), allowed by the CSP
# CDN_URL=https://cdn.mountaineermallu.com

# Optional: error tracking (sentry.io). Leave empty to keep it off.
SENTRY_DSN=

# Public site address used in share links (e.g. https://mountaineermallu.com). Defaults to the request host.
SITE_URL=
