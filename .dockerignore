.git
.gitignore
node_modules
*/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env
# Nested env files too (frontend/.env would bake VITE_API_URL=localhost into the bundle)
**/.env
**/.env.*
!**/.env.example
*.local
build.log
errors.log
crash.log
debug.log
.DS_Store
Thumbs.db

# Database backups hold user data and logs hold IPs/emails: never bake them into an image
backend/backups
backend/logs
logs
